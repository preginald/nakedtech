</tr>
</thead>
<tbody>
<tr>
<td class="border border-line p-4 align-top text-muted">Time</td>
<td class="border border-line p-4 align-top text-muted">Date and approximate start time</td>
</tr>
<tr>
<td class="border border-line p-4 align-top text-muted">Place</td>

---
layout: layouts/base.njk
title: Contact Naked Tech
description: Call Naked Tech on 03 7068 5422 or send us a message. Servicing Ivanhoe and Eaglemont with transparent home technology support.
---

<!-- Hero Section (Dark Mode) -->
<header class="bg-ivanhoe-slate text-skin-bone pt-32 pb-16 md:pt-40 md:pb-20">
    <div class="container mx-auto px-6 text-center max-w-4xl">
        <h1 class="text-4xl md:text-6xl font-extrabold mb-6 tracking-tight">
            Let's <span class="text-electric-peach">talk.</span>
        </h1>
        <p class="text-lg md:text-xl opacity-90 font-light mb-10 max-w-2xl mx-auto">
            Call or message us. We answer. No hold music, no ticket numbers — just a real person who knows what a router is.
        </p>

        <!-- Phone Number Callout -->
        <div class="inline-block bg-white/10 backdrop-blur-sm border border-white/15 rounded-3xl px-10 py-8 mb-4">
            <p class="text-sm font-bold uppercase tracking-[0.2em] text-electric-peach mb-3">Call us directly</p>
            <a href="tel:+61370685422" class="text-4xl md:text-5xl font-extrabold text-white hover:text-electric-peach transition-colors tracking-tight">
                03 7068 5422
            </a>
            <p class="mt-3 text-skin-bone/60 text-sm">Monday – Friday, 9am – 5pm</p>
        </div>
    </div>
</header>

<!-- Form Section -->
<section class="bg-skin-bone min-h-screen py-16 md:py-24">
    <div class="container mx-auto px-6 max-w-3xl">
        
        <div class="text-center mb-12">
            <p class="text-sm font-bold uppercase tracking-[0.2em] text-electric-peach-ink mb-3">Prefer to write?</p>
            <h2 class="text-3xl md:text-4xl font-bold text-ivanhoe-slate">Send us a message.</h2>
            <p class="mt-4 text-ivanhoe-slate/70 max-w-xl mx-auto leading-relaxed">
                Tell us what is misbehaving and how you would like us to reach you. We will get back within one business day.
            </p>
        </div>

        <!-- Sanctum Forms Embed -->
        <div class="bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-200">
            <!-- Fake Browser Header (Aesthetic touch) -->
            <div class="bg-gray-100 border-b border-gray-200 px-4 py-3 flex items-center gap-2">
                <div class="w-3 h-3 rounded-full bg-red-400"></div>
                <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
                <div class="w-3 h-3 rounded-full bg-green-400"></div>
                <div class="ml-4 text-xs text-gray-400 font-mono">message.nakedtech.au</div>
            </div>

            <!-- EMBED AREA -->
            <div class="w-full">
                <iframe 
                    id="contact-form"
                    src="https://forms.digitalsanctum.com.au/f/nakedtech-contact"
                    width="100%" 
                    height="650"
                    frameborder="0"
                    scrolling="no"
                    class="w-full"
                    title="Contact Naked Tech"
                    loading="lazy">
                </iframe>
            </div>
        </div>

        <p class="text-center text-gray-500 text-xs mt-6">
            Your details are handled by Digital Sanctum's secure forms platform and will never be shared or sold.
        </p>

    </div>
</section>

<script>
window.addEventListener('message', function(e) {
    if (e.data && e.data.type === 'sanctum-forms:resize') {
        var iframe = document.getElementById('contact-form');
        if (iframe && e.data.height) {
            iframe.style.height = e.data.height + 'px';
        }
    }
});
</script>

<!-- Info Cards Row -->
<section class="bg-white py-16 md:py-20">
    <div class="container mx-auto px-6 max-w-5xl">
        <div class="grid gap-6 md:grid-cols-3">
            
            <!-- Location Card -->
            <div class="bg-skin-bone rounded-2xl p-8 text-center">
                <div class="flex h-12 w-12 items-center justify-center rounded-full bg-electric-peach/20 text-electric-peach-ink mx-auto mb-4" aria-hidden="true">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                </div>
                <h3 class="text-lg font-bold text-ivanhoe-slate mb-2">Location</h3>
                <p class="text-ivanhoe-slate/70">Servicing Ivanhoe & Eaglemont<br>Victoria 3079</p>
            </div>

            <!-- Hours Card -->
            <div class="bg-skin-bone rounded-2xl p-8 text-center">
                <div class="flex h-12 w-12 items-center justify-center rounded-full bg-electric-peach/20 text-electric-peach-ink mx-auto mb-4" aria-hidden="true">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                </div>
                <h3 class="text-lg font-bold text-ivanhoe-slate mb-2">Hours</h3>
                <p class="text-ivanhoe-slate/70">Monday – Friday<br>9am – 5pm</p>
            </div>

            <!-- ABN Card -->
            <div class="bg-skin-bone rounded-2xl p-8 text-center">
                <div class="flex h-12 w-12 items-center justify-center rounded-full bg-electric-peach/20 text-electric-peach-ink mx-auto mb-4" aria-hidden="true">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
                </div>
                <h3 class="text-lg font-bold text-ivanhoe-slate mb-2">ABN</h3>
                <p class="text-ivanhoe-slate/70">57 221 340 918<br><span class="text-xs text-gray-500">Digital Sanctum (sole trader)</span></p>
            </div>

        </div>

        <!-- Need a service link -->
        <div class="text-center mt-12">
            <p class="text-gray-600 text-sm">
                Not sure which service fits? <a href="/services/" class="font-bold text-ivanhoe-slate underline hover:text-electric-peach-ink">Compare the four services.</a>
            </p>
        </div>
    </div>
</section>

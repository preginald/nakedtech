---
layout: layouts/base.njk
title: Contact Naked Tech
description: Call Naked Tech on 03 7068 5422 or send us a message. Servicing Ivanhoe and Eaglemont with transparent home technology support.
---

{% from "components/contact-form.njk" import contactForm %}

<!-- Hero Section (Dark Mode) -->
<header class="bg-inverse text-inverse-ink pt-32 pb-16 md:pt-40 md:pb-20">
    <div class="container mx-auto px-6 text-center max-w-4xl">
        <h1 class="text-4xl md:text-6xl font-extrabold mb-6 tracking-tight">
            Let's <span class="text-accent">talk.</span>
        </h1>
        <p class="text-lg md:text-xl opacity-90 font-light mb-10 max-w-2xl mx-auto">
            Call or message us. We answer. No hold music, no ticket numbers — just a real person who knows what a router is.
        </p>

        <!-- Phone Number Callout -->
        <div class="inline-block bg-white/10 backdrop-blur-sm border border-white/15 rounded-3xl px-10 py-8 mb-4">
            <p class="text-sm font-bold uppercase tracking-[0.2em] text-accent mb-3">Call us directly</p>
            <a href="tel:+61370685422" class="text-4xl md:text-5xl font-extrabold text-white hover:text-accent transition-colors tracking-tight">
                03 7068 5422
            </a>
            <p class="mt-3 text-inverse-ink/60 text-sm">Monday – Friday, 9am – 5pm</p>
        </div>
    </div>
</header>

{{ contactForm({
    id: 'contact',
    kicker: 'Prefer to write?',
    heading: 'Send us a message.',
    introduction: 'Tell us what is misbehaving and how you would like us to reach you. We will get back within one business day.'
}) }}

<!-- Info Cards Row -->
<section class="bg-surface py-16 md:py-20">
    <div class="container mx-auto px-6 max-w-5xl">
        <div class="grid gap-6 md:grid-cols-3">
            
            <!-- Location Card -->
            <div class="bg-canvas rounded-2xl p-8 text-center">
                <div class="flex h-12 w-12 items-center justify-center rounded-full bg-accent/20 text-accent-ink mx-auto mb-4" aria-hidden="true">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                </div>
                <h3 class="text-lg font-bold text-ink mb-2">Location</h3>
                <p class="text-ink/70">Servicing Ivanhoe VIC 3079<br>& Eaglemont VIC 3084</p>
            </div>

            <!-- Hours Card -->
            <div class="bg-canvas rounded-2xl p-8 text-center">
                <div class="flex h-12 w-12 items-center justify-center rounded-full bg-accent/20 text-accent-ink mx-auto mb-4" aria-hidden="true">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                </div>
                <h3 class="text-lg font-bold text-ink mb-2">Hours</h3>
                <p class="text-ink/70">Monday – Friday<br>9am – 5pm</p>
            </div>

            <!-- ABN Card -->
            <div class="bg-canvas rounded-2xl p-8 text-center">
                <div class="flex h-12 w-12 items-center justify-center rounded-full bg-accent/20 text-accent-ink mx-auto mb-4" aria-hidden="true">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
                </div>

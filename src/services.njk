---
layout: layouts/base.njk
title: Services & Pricing
description: Local Mesh Wi-Fi, smart security, home office and everyday tech support for Ivanhoe and Eaglemont, with transparent pricing.
---

<div class="pt-32 pb-20 container mx-auto px-6">

    <!-- Hero Section -->
    <header class="max-w-4xl mx-auto text-center mb-16">
        <h1 class="text-4xl sm:text-5xl md:text-7xl font-extrabold mb-6 text-ivanhoe-slate">
            The Menu.
        </h1>
        <p class="mx-auto max-w-2xl text-lg leading-relaxed text-ivanhoe-slate/80 md:text-xl">
            Pick the problem that sounds familiar. Every service shows you what is included, how the visit works and what the typical investment looks like.
        </p>
    </header>

    <!-- Pricing Banner -->
    <section class="max-w-3xl mx-auto mb-20">
        <div class="border-2 border-ivanhoe-slate rounded-2xl p-8 md:p-12 text-center bg-white shadow-sm relative overflow-hidden">
            <!-- Decorative Accent -->
            <div class="absolute top-0 left-0 w-full h-2 bg-electric-peach"></div>

            <h2 class="text-4xl sm:text-5xl md:text-7xl font-bold text-ivanhoe-slate mb-4">
                $190 <span class="text-2xl text-gray-500 font-medium">/ hour</span>
            </h2>
            
            <div class="space-y-2 text-lg text-gray-700">
                <p class="font-medium">0% Call-Out Fee for Ivanhoe (3079).</p>
                <p class="text-sm opacity-80">Minimum 1 hour charge. Billed in 30-min blocks thereafter.</p>
            </div>

            <div class="mt-8 inline-block bg-skin-bone px-4 py-2 rounded-lg text-sm font-semibold text-ivanhoe-slate border border-ivanhoe-slate/10">
                Hardware sold at cost. No markups.
            </div>
        </div>
    </section>

    <!-- Visual Break Image -->
    <div class="max-w-5xl mx-auto mb-24 px-6 md:px-0">
        <img
            src="/img/services-hero.webp"
            alt="Technician setting up a compact home device beside a window"
            width="1408"
            height="768"
            class="h-64 w-full rounded-2xl object-cover shadow-xl md:h-[400px]"
        >
    </div>

    <!-- Service Grid -->
    <section class="max-w-5xl mx-auto mb-24" aria-labelledby="service-options-heading">
        <div class="mb-10 text-center">
            <p class="text-sm font-bold uppercase tracking-[0.18em] text-electric-peach-ink">Four ways to get sorted</p>
            <h2 id="service-options-heading" class="mt-3 text-3xl font-extrabold text-ivanhoe-slate md:text-4xl">Choose your problem.</h2>
        </div>
        <div class="grid gap-8 md:grid-cols-2">
            {% for service in services %}
            <article class="flex h-full flex-col rounded-2xl border border-gray-100 bg-white p-6 shadow-md transition hover:-translate-y-1 hover:shadow-xl md:p-10">
                <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-full bg-skin-bone text-electric-peach" aria-hidden="true">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="{{ service.iconPath }}"></path></svg>
                </div>
                <p class="text-sm font-bold uppercase tracking-widest text-electric-peach-ink">{{ service.category }}</p>
                <h3 class="mt-2 text-2xl font-bold text-ivanhoe-slate">{{ service.name }}</h3>
                <p class="mt-3 flex-grow leading-relaxed text-gray-600">{{ service.cardDescription }}</p>
                <dl class="mt-6 grid grid-cols-2 gap-4 border-y border-gray-100 py-5">
                    <div>
                        <dt class="text-xs font-bold uppercase tracking-wide text-gray-600">Typical</dt>
                        <dd class="mt-1 font-bold text-ivanhoe-slate">{{ service.typicalInvestment }}</dd>
                    </div>
                    <div>
                        <dt class="text-xs font-bold uppercase tracking-wide text-gray-600">Structure</dt>
                        <dd class="mt-1 text-sm font-bold text-ivanhoe-slate">{{ service.priceLine }}</dd>
                    </div>
                </dl>
                <a href="/services/{{ service.slug }}/" class="mt-5 inline-flex min-h-11 items-center font-bold text-electric-peach-ink hover:text-ivanhoe-slate hover:underline">
                    Explore {{ service.name }} <span class="ml-2" aria-hidden="true">→</span>
                </a>
            </article>
            {% endfor %}
        </div>
    </section>

    <!-- Booking CTA -->
    <section class="text-center max-w-2xl mx-auto">
        <h2 class="text-3xl font-bold mb-6 text-ivanhoe-slate">Ready to book?</h2>
        <p class="text-lg text-gray-600 mb-8">
            Tell us what you need, and we'll send our best guy.
        </p>
        
        <a href="/contact/" class="inline-flex min-h-14 items-center justify-center rounded-full bg-ivanhoe-slate px-10 py-4 text-lg font-bold text-skin-bone shadow-xl transition-all hover:-translate-y-1 hover:bg-gray-800">
        BOOK A TECHNICIAN
        </a>
    </section>

</div>
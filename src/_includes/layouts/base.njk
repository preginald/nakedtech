    <script data-tracking-consent-controls>
    (function() {
        var tracking = window.nakedTechTracking;
        if (!tracking) return;
        var banner = document.querySelector('[data-tracking-consent-banner]');
        var dialog = document.querySelector('[data-tracking-preferences-dialog]');
        var heading = document.querySelector('#tracking-preferences-heading');
        var analytics = document.querySelector('[data-tracking-analytics]');
        var advertising = document.querySelector('[data-tracking-advertising]');
        var previousFocus = null;

        function savePreferences(nextPreferences) {
            var current = tracking.getPreferences();
            var categoryWasWithdrawn = (current.analytics && !nextPreferences.analytics)
                || (current.advertising && !nextPreferences.advertising);
            tracking.setPreferences(nextPreferences);
            banner.hidden = true;
            dialog.hidden = true;
            if (categoryWasWithdrawn) window.location.reload();
        }

        function openPreferences() {
            var current = tracking.getPreferences();
            previousFocus = document.activeElement;
            analytics.checked = current.analytics;
            advertising.checked = current.advertising;
            dialog.hidden = false;
            dialog.classList.remove('hidden');
            dialog.classList.add('flex');
            window.requestAnimationFrame(function() {
                heading.focus();
            });
        }

        function closePreferences() {
            dialog.hidden = true;
            dialog.classList.remove('flex');
            dialog.classList.add('hidden');
            if (previousFocus && typeof previousFocus.focus === 'function') previousFocus.focus();
        }

        document.querySelectorAll('[data-tracking-preferences-open]').forEach(function(button) {
            button.addEventListener('click', openPreferences);
        });
        document.querySelector('[data-tracking-choose]').addEventListener('click', openPreferences);
        document.querySelector('[data-tracking-reject]').addEventListener('click', function() {
            savePreferences({ analytics: false, advertising: false });
        });
        document.querySelector('[data-tracking-accept]').addEventListener('click', function() {
            savePreferences({ analytics: true, advertising: true });
        });
        document.querySelector('[data-tracking-preferences-save]').addEventListener('click', function() {
            savePreferences({
                analytics: analytics.checked,
                advertising: advertising.checked
            });
        });
        document.querySelector('[data-tracking-preferences-close]').addEventListener('click', closePreferences);
        document.querySelector('[data-tracking-preferences-cancel]').addEventListener('click', closePreferences);
        document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape' && !dialog.hidden) closePreferences();
        });

        banner.hidden = tracking.hasChoice();
    })();
    </script>

    <script data-theme-controls>
    (function() {
        var root = document.documentElement;
        var storageKey = 'nakedtech-theme';
        var media = window.matchMedia('(prefers-color-scheme: dark)');
        var buttons = Array.prototype.slice.call(document.querySelectorAll('[data-theme-choice]'));
        var themeMeta = document.querySelector('[data-theme-color]');

        function applyTheme(choice, persist) {
            var resolved = choice === 'system' ? (media.matches ? 'dark' : 'light') : choice;
            root.dataset.themeChoice = choice;
            root.dataset.resolvedTheme = resolved;
            if (choice === 'system') root.removeAttribute('data-theme');
            else root.dataset.theme = choice;

            if (persist) {
                try {
                    if (choice === 'system') localStorage.removeItem(storageKey);
                    else localStorage.setItem(storageKey, choice);
                } catch (error) {}
            }

            if (themeMeta) themeMeta.setAttribute('content', resolved === 'dark' ? '#141619' : '#F7F4EF');
            document.querySelectorAll('iframe').forEach(function(frame) {
                frame.style.colorScheme = resolved;
            });
            buttons.forEach(function(button) {
                var selected = button.dataset.themeChoice === choice;
                button.setAttribute('aria-pressed', selected ? 'true' : 'false');
                button.classList.toggle('bg-accent', selected);
                button.classList.toggle('text-ivanhoe-slate', selected);
            });
            document.querySelectorAll('[data-theme-check]').forEach(function(check) {
                check.hidden = check.dataset.themeCheck !== choice;
            });
        }

        buttons.forEach(function(button) {
            button.addEventListener('click', function() {
                applyTheme(button.dataset.themeChoice, true);
            });
        });

        var systemChange = function() {
            if (root.dataset.themeChoice === 'system') applyTheme('system', false);
        };
        if (typeof media.addEventListener === 'function') media.addEventListener('change', systemChange);
        else if (typeof media.addListener === 'function') media.addListener(systemChange);

        applyTheme(root.dataset.themeChoice || 'system', false);
    })();
    </script>

    <script data-navigation-disclosures>
    (function() {
        var disclosures = Array.prototype.slice.call(document.querySelectorAll('[data-nav-disclosure]'));
        disclosures.forEach(function(disclosure) {
            disclosure.addEventListener('toggle', function() {
                if (!disclosure.open) return;
                disclosures.forEach(function(other) {
                    if (other !== disclosure) other.removeAttribute('open');
                });
            });
            disclosure.addEventListener('click', function(event) {
                if (event.target.closest('a')) disclosure.removeAttribute('open');
            });
        });
        document.addEventListener('click', function(event) {
            disclosures.forEach(function(disclosure) {
                if (!disclosure.contains(event.target)) disclosure.removeAttribute('open');
            });
        });
        document.addEventListener('keydown', function(event) {
            if (event.key !== 'Escape') return;
            disclosures.forEach(function(disclosure) { disclosure.removeAttribute('open'); });
        });
    })();
    </script>

    <script data-phone-click-tracking>
    (function() {
        document.addEventListener('click', function(e) {
            var target = e.target;
            var link = target && typeof target.closest === 'function'
                ? target.closest('a[href^="tel:"]')
                : null;
            if (!link) return;

            var context = { page_path: window.location.pathname };
            var painPoint = document.body.dataset.painPoint;
            if (painPoint) context.pain_point = painPoint;

            if (typeof fbq === 'function') {
                fbq('track', 'Contact', context);
            }
            if (typeof gtag === 'function') {
                gtag('event', 'phone_click', context);
            }
        });
    })();
    </script>


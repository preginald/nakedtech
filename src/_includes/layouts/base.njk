    <script data-theme-bootstrap>
    (function() {
        var root = document.documentElement;
        var choice = 'system';
        try {
            var saved = localStorage.getItem('nakedtech-theme');
            if (saved === 'light' || saved === 'dark') choice = saved;
        } catch (error) {}
        var systemDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        var resolved = choice === 'system' ? (systemDark ? 'dark' : 'light') : choice;
        root.dataset.themeChoice = choice;
        root.dataset.resolvedTheme = resolved;
        if (choice === 'system') root.removeAttribute('data-theme');
        else root.dataset.theme = choice;
    })();
    </script>
    <script data-tracking-consent-bootstrap>
    (function() {
        var storageKey = 'nakedtech-tracking-consent-v1';
        var consentVersion = 1;
        var analyticsId = 'G-6RN5LVVSGL';
        var advertisingId = '1010322558552545';
        var pendingAnalytics = [];
        var pendingAdvertising = [];
        var analyticsLoaded = false;
        var advertisingLoaded = false;
        var hasChoice = false;
        var preferences = {
            version: consentVersion,
            analytics: false,
            advertising: false
        };

        window.gtag = function() {
            pendingAnalytics.push(Array.prototype.slice.call(arguments));
        };
        window.fbq = function() {
            pendingAdvertising.push(Array.prototype.slice.call(arguments));
        };

        function normalisePreferences(value) {
            if (!value || value.version !== consentVersion) return null;
            if (typeof value.analytics !== 'boolean' || typeof value.advertising !== 'boolean') return null;
            return {
                version: consentVersion,
                analytics: value.analytics,
                advertising: value.advertising
            };
        }

        function insertProviderScript(source, provider) {
            var script = document.createElement('script');
            script.async = true;
            script.src = source;
            script.dataset.trackingProvider = provider;
            document.head.appendChild(script);
        }

        function loadAnalytics() {
            if (analyticsLoaded) return;
            analyticsLoaded = true;
            var deferred = pendingAnalytics.slice();
            pendingAnalytics.length = 0;
            window.dataLayer = window.dataLayer || [];
            window.gtag = function() {
                window.dataLayer.push(arguments);
            };
            window.gtag('js', new Date());
            window.gtag('config', analyticsId);
            deferred.forEach(function(args) {
                window.gtag.apply(null, args);
            });
            insertProviderScript(
                'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(analyticsId),
                'analytics'
            );
        }

        function loadAdvertising() {
            if (advertisingLoaded) return;
            advertisingLoaded = true;
            var deferred = pendingAdvertising.slice();
            pendingAdvertising.length = 0;
            var metaQueue = function() {
                if (metaQueue.callMethod) metaQueue.callMethod.apply(metaQueue, arguments);
                else metaQueue.queue.push(arguments);
            };
            window.fbq = metaQueue;
            window._fbq = metaQueue;
            metaQueue.push = metaQueue;
            metaQueue.loaded = true;
            metaQueue.version = '2.0';
            metaQueue.queue = [];
            window.fbq('init', advertisingId);
            window.fbq('track', 'PageView');
            deferred.forEach(function(args) {
                window.fbq.apply(null, args);
            });
            insertProviderScript('https://connect.facebook.net/en_US/fbevents.js', 'advertising');
        }

        function applyPreferences(nextPreferences, persist) {
            preferences = normalisePreferences(nextPreferences) || {
                version: consentVersion,
                analytics: false,
                advertising: false
            };
            if (persist) {
                hasChoice = true;
                try {
                    localStorage.setItem(storageKey, JSON.stringify(preferences));
                } catch (error) {}
            }
            if (preferences.analytics) loadAnalytics();
            if (preferences.advertising) loadAdvertising();
        }

        try {
            var savedPreferences = normalisePreferences(JSON.parse(localStorage.getItem(storageKey)));
            if (savedPreferences) {
                hasChoice = true;
                preferences = savedPreferences;
            }
        } catch (error) {}

        window.nakedTechTracking = {
            storageKey: storageKey,
            version: consentVersion,
            getPreferences: function() {
                return {
                    analytics: preferences.analytics,
                    advertising: preferences.advertising
                };
            },
            hasChoice: function() {
                return hasChoice;
            },
            setPreferences: function(nextPreferences) {
                applyPreferences({
                    version: consentVersion,
                    analytics: nextPreferences.analytics === true,
                    advertising: nextPreferences.advertising === true
                }, true);
            }
        };

        if (hasChoice) applyPreferences(preferences, false);
    })();
    </script>


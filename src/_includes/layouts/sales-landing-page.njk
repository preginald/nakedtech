---
layout: layouts/base.njk
---

{% from "components/contact-form.njk" import contactForm %}

{% macro jsonValue(value) -%}
{{ value | dump | replace('<', '\\u003c') | replace('>', '\\u003e') | replace('&', '\\u0026') | safe }}
{%- endmacro %}

<header id="offer" class="relative scroll-mt-20 overflow-hidden bg-ivanhoe-slate pt-28 pb-16 text-skin-bone md:pt-36 md:pb-24">
    <div class="absolute inset-0 opacity-10" aria-hidden="true">
        <div class="absolute -right-24 -top-24 h-96 w-96 rounded-full border-[64px] border-electric-peach"></div>
        <div class="absolute -bottom-32 left-1/4 h-72 w-72 rounded-full border-[48px] border-white"></div>
    </div>

    <div class="container relative mx-auto grid items-center gap-10 px-6 lg:grid-cols-[1.15fr_0.85fr] lg:gap-14">
        <div>
            <p class="text-sm font-bold uppercase tracking-[0.18em] text-electric-peach">{{ landing.eyebrow }}</p>
            <h1 class="mt-4 max-w-4xl text-4xl font-extrabold leading-tight tracking-tight sm:text-5xl lg:text-6xl">{{ landing.headline }}</h1>
            <p class="mt-6 max-w-2xl text-lg leading-relaxed text-skin-bone/80 md:text-xl">{{ landing.promise }}</p>

            <div class="mt-9 flex flex-col gap-4 sm:flex-row">
                <a href="{{ landing.cta.primaryHref }}" class="inline-flex min-h-14 items-center justify-center rounded-full bg-electric-peach px-8 py-4 text-base font-bold text-ivanhoe-slate shadow-xl shadow-black/20 transition hover:-translate-y-0.5 hover:bg-[#FF7A50]">
                    {{ landing.cta.primaryLabel }}
                </a>
                <a href="{{ site.phone.href }}" aria-label="{{ landing.cta.phoneLabel }}" class="inline-flex min-h-14 items-center justify-center gap-3 rounded-full border border-skin-bone/35 px-8 py-4 text-base font-bold text-skin-bone transition hover:border-electric-peach hover:text-electric-peach">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                    {{ site.phone.display }}
                </a>
            </div>
        </div>

        <aside class="rounded-3xl border border-white/15 bg-white/10 p-6 shadow-2xl backdrop-blur-sm md:p-8" aria-label="Starting offer">
            <p class="text-sm font-bold uppercase tracking-[0.18em] text-skin-bone/60">{{ landing.offer.label }}</p>
            <p class="mt-3 text-4xl font-extrabold tracking-tight text-electric-peach">{{ landing.offer.price }}</p>
            <p class="mt-5 border-t border-white/15 pt-5 text-sm leading-relaxed text-skin-bone/75">{{ landing.offer.note }}</p>
            <a href="#symptoms" class="mt-6 inline-flex min-h-11 items-center font-bold text-skin-bone transition hover:text-electric-peach hover:underline">
                See what we check <span class="ml-2" aria-hidden="true">↓</span>
            </a>
        </aside>
    </div>
</header>

<section id="symptoms" class="scroll-mt-20 py-16 md:py-24" aria-labelledby="symptoms-heading">
    <div class="container mx-auto px-6">
        <div class="mx-auto max-w-3xl text-center">
            <p class="text-sm font-bold uppercase tracking-[0.18em] text-electric-peach-ink">The symptoms</p>
            <h2 id="symptoms-heading" class="mt-3 text-3xl font-extrabold tracking-tight md:text-4xl">Does this sound familiar?</h2>
        </div>
        <div class="mx-auto mt-12 grid max-w-6xl gap-6 md:grid-cols-3">
            {% for symptom in landing.symptoms %}
            <article class="rounded-2xl border border-ivanhoe-slate/10 bg-white p-6 shadow-sm md:p-8">
                <span class="text-sm font-extrabold text-electric-peach-ink" aria-hidden="true">0{{ loop.index }}</span>
                <h3 class="mt-4 text-xl font-bold">{{ symptom.title }}</h3>
                <p class="mt-3 leading-relaxed text-ivanhoe-slate/70">{{ symptom.description }}</p>
            </article>
            {% endfor %}
        </div>
    </div>
</section>

<section id="diagnosis" class="scroll-mt-20 bg-white py-16 md:py-24" aria-labelledby="diagnosis-heading">
    <div class="container mx-auto grid gap-12 px-6 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
        <div class="lg:sticky lg:top-28">
            <p class="text-sm font-bold uppercase tracking-[0.18em] text-electric-peach-ink">Diagnose before buying</p>
            <h2 id="diagnosis-heading" class="mt-3 text-3xl font-extrabold tracking-tight md:text-4xl">{{ landing.diagnosis.heading }}</h2>
            <p class="mt-5 text-lg leading-relaxed text-ivanhoe-slate/70">{{ landing.diagnosis.summary }}</p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
            {% for check in landing.diagnosis.checks %}
            <article class="rounded-2xl bg-skin-bone p-6 md:p-8">
                <span class="flex h-11 w-11 items-center justify-center rounded-full bg-electric-peach/20 text-electric-peach-ink" aria-hidden="true">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
                </span>
                <h3 class="mt-5 text-xl font-bold">{{ check.title }}</h3>
                <p class="mt-3 leading-relaxed text-ivanhoe-slate/70">{{ check.description }}</p>
            </article>
            {% endfor %}
        </div>
    </div>
</section>

<section id="included" class="scroll-mt-20 py-16 md:py-24" aria-labelledby="included-heading">
    <div class="container mx-auto px-6">
        <div class="mx-auto max-w-3xl text-center">
            <p class="text-sm font-bold uppercase tracking-[0.18em] text-electric-peach-ink">What is included</p>
            <h2 id="included-heading" class="mt-3 text-3xl font-extrabold tracking-tight md:text-4xl">Clear scope. No mystery box.</h2>
        </div>
        <div class="mx-auto mt-12 grid max-w-6xl gap-5 md:grid-cols-2">
            {% for inclusion in landing.inclusions %}
            <article class="flex gap-4 rounded-2xl border border-ivanhoe-slate/10 bg-white p-6 shadow-sm md:p-8">
                <svg class="mt-1 h-6 w-6 shrink-0 text-electric-peach-ink" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                <div>
                    <h3 class="text-xl font-bold">{{ inclusion.title }}</h3>
                    <p class="mt-3 leading-relaxed text-ivanhoe-slate/70">{{ inclusion.description }}</p>
                </div>
            </article>
            {% endfor %}
        </div>
    </div>
</section>

<section id="process" class="scroll-mt-20 bg-ivanhoe-slate py-16 text-skin-bone md:py-24" aria-labelledby="process-heading">
    <div class="container mx-auto px-6">
        <div class="mx-auto max-w-3xl text-center">
            <p class="text-sm font-bold uppercase tracking-[0.18em] text-electric-peach">How it works</p>
            <h2 id="process-heading" class="mt-3 text-3xl font-extrabold tracking-tight md:text-4xl">From frustrating to understood.</h2>
        </div>
        <ol class="mx-auto mt-14 grid max-w-6xl gap-8 md:grid-cols-3">
            {% for step in landing.process %}
            <li class="relative rounded-2xl border border-white/15 bg-white/5 p-6 pt-9 md:p-8 md:pt-10">
                <span class="absolute -top-5 left-6 flex h-11 min-w-11 items-center justify-center rounded-full bg-electric-peach px-3 text-sm font-extrabold text-ivanhoe-slate">{{ loop.index }}</span>
                <h3 class="text-xl font-bold text-electric-peach">{{ step.title }}</h3>
                <p class="mt-3 leading-relaxed text-skin-bone/75">{{ step.description }}</p>
            </li>
            {% endfor %}
        </ol>
    </div>
</section>

<section id="proof" class="scroll-mt-20 py-16 md:py-24" aria-labelledby="proof-heading">
    <div class="container mx-auto px-6">
        <div class="grid gap-10 lg:grid-cols-[0.65fr_1.35fr] lg:items-start">
            <div>
                <p class="text-sm font-bold uppercase tracking-[0.18em] text-electric-peach-ink">Why Naked Tech</p>
                <h2 id="proof-heading" class="mt-3 text-3xl font-extrabold tracking-tight md:text-4xl">Trust should be visible.</h2>
            </div>
            <div class="grid gap-5 md:grid-cols-3">
                {% for proof in landing.proofPoints %}
                <article class="rounded-2xl border border-ivanhoe-slate/10 bg-white p-6 shadow-sm">
                    <h3 class="text-lg font-bold text-ivanhoe-slate">{{ proof.title }}</h3>
                    <p class="mt-3 text-sm leading-relaxed text-ivanhoe-slate/70">{{ proof.description }}</p>
                </article>
                {% endfor %}
            </div>
        </div>
    </div>
</section>

<section id="pricing" class="scroll-mt-20 bg-white py-16 md:py-24" aria-labelledby="pricing-heading">
    <div class="container mx-auto px-6">
        <div class="mx-auto grid max-w-6xl overflow-hidden rounded-3xl shadow-2xl lg:grid-cols-[0.9fr_1.1fr]">
            <div class="bg-electric-peach p-7 text-ivanhoe-slate md:p-10 lg:p-12">
                <p class="text-sm font-bold uppercase tracking-[0.18em]">{{ landing.offer.label }}</p>
                <h2 id="pricing-heading" class="mt-3 text-3xl font-extrabold tracking-tight md:text-4xl">{{ landing.offer.price }}</h2>
                <p class="mt-6 leading-relaxed">{{ landing.offer.note }}</p>
                <div class="mt-8 flex flex-col gap-3 sm:flex-row lg:flex-col xl:flex-row">
                    <a href="{{ landing.cta.primaryHref }}" class="inline-flex min-h-14 items-center justify-center rounded-full bg-ivanhoe-slate px-8 py-4 text-base font-bold text-white transition hover:-translate-y-0.5 hover:bg-black">{{ landing.cta.primaryLabel }}</a>
                    <a href="{{ site.phone.href }}" aria-label="{{ landing.cta.phoneLabel }}" class="inline-flex min-h-14 items-center justify-center rounded-full border-2 border-ivanhoe-slate px-8 py-4 text-base font-bold text-ivanhoe-slate transition hover:bg-ivanhoe-slate hover:text-white">{{ site.phone.display }}</a>
                </div>
            </div>
            <div class="bg-ivanhoe-slate p-7 text-skin-bone md:p-10 lg:p-12">
                <p class="text-sm font-bold uppercase tracking-[0.18em] text-electric-peach">Included in the visit</p>
                <ul class="mt-7 space-y-5">
                    {% for inclusion in landing.inclusions %}
                    <li class="flex gap-3">
                        <svg class="mt-0.5 h-5 w-5 shrink-0 text-electric-peach" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                        <span class="leading-relaxed text-skin-bone/85"><strong class="text-skin-bone">{{ inclusion.title }}.</strong> {{ inclusion.description }}</span>
                    </li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    </div>
</section>

<section id="faq" class="scroll-mt-20 py-16 md:py-24" aria-labelledby="faq-heading">
    <div class="container mx-auto px-6">
        <div class="mx-auto max-w-3xl">
            <p class="text-sm font-bold uppercase tracking-[0.18em] text-electric-peach-ink">Before you book</p>
            <h2 id="faq-heading" class="mt-3 text-3xl font-extrabold tracking-tight md:text-4xl">Frequently asked, fully answered.</h2>
            <div class="mt-10 divide-y divide-ivanhoe-slate/10 border-y border-ivanhoe-slate/10">
                {% for faq in landing.faqs %}
                <details class="group py-2">
                    <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-6 py-4 text-lg font-bold">
                        <span>{{ faq.question }}</span>
                        <span class="text-2xl font-light text-electric-peach-ink transition group-open:rotate-45" aria-hidden="true">+</span>
                    </summary>
                    <p class="max-w-2xl pb-6 pr-12 leading-relaxed text-ivanhoe-slate/70">{{ faq.answer }}</p>
                </details>
                {% endfor %}
            </div>
        </div>
    </div>
</section>

<aside class="bg-ivanhoe-slate px-6 py-12 text-center text-skin-bone" aria-label="Telephone enquiry">
    <p class="text-sm font-bold uppercase tracking-[0.18em] text-electric-peach">Prefer to talk it through?</p>
    <p class="mx-auto mt-3 max-w-2xl text-lg text-skin-bone/75">Call Naked Tech directly and explain what is happening. No hold music, no ticket number.</p>
    <a href="{{ site.phone.href }}" aria-label="{{ landing.cta.phoneLabel }}" class="mt-6 inline-flex min-h-14 items-center justify-center rounded-full bg-electric-peach px-8 py-4 text-xl font-extrabold text-ivanhoe-slate transition hover:-translate-y-0.5 hover:bg-[#FF7A50]">{{ site.phone.display }}</a>
</aside>

{{ contactForm({
    id: 'contact',
    kicker: 'Prefer to write?',
    heading: landing.form.heading,
    introduction: landing.form.introduction,
    painPoint: landing.form.contextKey,
    iframeTitle: 'Contact Naked Tech about ' ~ landing.headline
}) }}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "name": {{ jsonValue(landing.schema.serviceType) }},
  "serviceType": {{ jsonValue(landing.schema.serviceType) }},
  "description": {{ jsonValue(description) }},
  "url": {{ jsonValue(site.url ~ page.url) }},
  "provider": {
    "@type": "LocalBusiness",
    "name": {{ jsonValue(site.name) }},
    "url": {{ jsonValue(site.url) }},
    "telephone": {{ jsonValue(site.phone.display) }}
  },
  "areaServed": [
    {% for area in landing.schema.areaServed %}{{ jsonValue(area) }}{% if not loop.last %},{% endif %}{% endfor %}
  ],
  "offers": {
    "@type": "Offer",
    "description": {{ jsonValue(landing.offer.label ~ ': ' ~ landing.offer.price ~ '. ' ~ landing.offer.note) }}
  }
}
</script>

<script data-pain-page-view-tracking>
(function() {
    var context = {
        pain_point: {{ jsonValue(landing.id) }},
        page_path: window.location.pathname
    };
    var campaignContent = new URLSearchParams(window.location.search).get('utm_content');

    if (campaignContent) {
        campaignContent = campaignContent.trim();
        if (campaignContent) context.campaign_content = campaignContent;
    }

    if (typeof fbq === 'function') {
        fbq('track', 'ViewContent', context);
    }
    if (typeof gtag === 'function') {
        gtag('event', 'view_service', context);
    }
})();
</script>

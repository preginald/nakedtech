{# Editorial kit: semantic HTML first; icons are decorative, labels carry meaning. #}
{% macro icon(kind) %}
<svg class="ed-icon" width="40" height="40" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
{% if kind == 'fix' %}<path d="M29 8a10 10 0 0 0-12 13L7 31a5 5 0 0 0 7 7l10-10A10 10 0 0 0 37 16l-7 7-6-6 7-7Z"/>
{% elif kind == 'upgrade' %}<rect x="10" y="18" width="28" height="22" rx="3"/><path d="M24 30V6m-7 7 7-7 7 7M16 35h3m10 0h3"/>
{% elif kind == 'replace' %}<rect x="6" y="8" width="36" height="26" rx="3"/><path d="M17 41h14m-7-7v7M12 27h24m-5-12 4 4-4 4m-14-8-4 4 4 4"/>
{% elif kind == 'care' %}<path d="m24 5 18 33H6L24 5Z M24 17v10m0 5v1"/>
{% else %}<circle cx="24" cy="24" r="17"/><path d="M24 21v12m0-19v1"/>{% endif %}
</svg>
{% endmacro %}

{% macro choice(title, detail, href, artwork, artworkSrc, artworkAlt, actionLabel='Explore this symptom') %}
{% set artDescriptions = { startup: 'A laptop powering on beside a clock.', applications: 'Application windows on a laptop beside an hourglass.', online: 'A globe on a laptop screen beside a Wi-Fi router.' } %}
<a class="ed-choice" href="{{ href }}">{% if artwork %}<span class="ed-choice-art ed-choice-art--{{ artwork }}"><!-- themed artwork -->{% if artworkSrc %}<img class="ed-art-custom" src="{{ artworkSrc }}" width="2172" height="724" alt="{{ artworkAlt }}" decoding="async">{% else %}<img class="ed-art-light" src="/img/guides/slowdown-situations-v1.webp" width="2172" height="724" alt="{{ artDescriptions[artwork] }}" decoding="async"><img class="ed-art-dark" src="/img/guides/slowdown-situations-dark-v1.webp" width="2172" height="724" alt="{{ artDescriptions[artwork] }}" decoding="async">{% endif %}</span>{% endif %}<strong>{{ title }}</strong><span>{{ detail }}</span><span class="ed-choice-action">{{ actionLabel }} <span aria-hidden="true">↗</span></span></a>
{% endmacro %}

{% macro decision(kind, title, situation, question, exampleText) %}
<section class="ed-decision">{{ icon(kind) }}<h3>{{ title }}</h3><p>{{ situation }}</p><div class="ed-question"><span class="ed-label">Ask this</span><p>{{ question }}</p></div>
{% if exampleText %}<details class="ed-example ed-decision-example"><summary>See an example<span class="sr-only"> — {{ title }}</span><span aria-hidden="true">⌄</span></summary><div class="ed-example-body"><p>{{ exampleText }}</p></div></details>{% endif %}
</section>
{% endmacro %}

{% macro note(kind, label, title) %}
<aside class="ed-note ed-note--{{ kind }}">{{ icon(kind) }}<div><p class="ed-label">{{ label }}</p><h3>{{ title }}</h3>{{ caller() }}</div></aside>
{% endmacro %}

{# Educational continuation first. Commercial facts belong on the destination page. #}
{% macro nextReading(links, helpHref, helpLabel, sectionNumber='05') %}
<section class="ed-next" aria-labelledby="related">
<h2 class="ed-section-heading" id="related"><span aria-hidden="true">{{ sectionNumber }}</span>What to read next</h2>
<ul class="ed-next-list">
{% for link in links %}<li><a href="{{ link.href }}">{{ link.title }} <span aria-hidden="true">→</span></a></li>{% endfor %}
</ul>
<p class="ed-library-link"><a href="/guides/">Browse all practical guides <span aria-hidden="true">→</span></a></p>
{% if helpHref %}<p class="ed-optional-help">If you’d rather have local help, see our <a href="{{ helpHref }}">{{ helpLabel }}</a>.</p>{% endif %}
</section>
{% endmacro %}

{% macro example(title) %}
<details class="ed-example"><summary>{{ title }}<span aria-hidden="true">⌄</span></summary><div class="ed-example-body">{{ caller() }}</div></details>
{% endmacro %}

{% macro contents(sections) %}
<nav data-editorial-contents class="ed-toc" aria-label="In this guide">
<p class="ed-label ed-toc-desktop-label">In this guide</p>
<button class="ed-toc-toggle" type="button" aria-expanded="false" aria-controls="editorial-contents-links" hidden><span class="ed-toc-prefix">In this guide</span><span data-current-section class="ed-toc-current">{{ sections[0].title }}</span><span class="ed-toc-chevron" aria-hidden="true">⌄</span></button>
<div class="ed-toc-links" id="editorial-contents-links">{% for section in sections %}<a href="#{{ section.id }}">{{ section.title }}</a>{% endfor %}</div>
</nav>
{% endmacro %}

{# Each scene of an intentionally composed triptych supports adjacent prose. #}
{% macro triptychFigure(src, scene, alt, caption) %}
<figure class="ed-illustration" data-editorial-visual>
<div class="ed-illustration-frame ed-illustration-frame--{{ scene }}"><img src="{{ src }}" width="2172" height="724" alt="{{ alt }}" loading="lazy" decoding="async"></div>
<figcaption>{{ caption }}</figcaption>
</figure>
{% endmacro %}

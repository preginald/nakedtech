{% macro contactForm(props) %}
{% set formId = props.id or 'contact' %}
{% set formKicker = props.kicker or 'Prefer to write?' %}
{% set formHeading = props.heading or 'Send us a message.' %}
{% set formIntroduction = props.introduction or 'Tell us what is misbehaving and how you would like us to reach you. We will get back within one business day.' %}
{% set iframeTitle = props.iframeTitle or 'Contact Naked Tech' %}
{% set formSlug = props.formSlug or 'nakedtech-contact' %}
<section id="{{ formId }}" class="bg-canvas min-h-screen py-16 md:py-24" data-contact-form-root data-pagefind-ignore data-pain-point="{{ props.painPoint or '' }}">
    <div class="container mx-auto px-6 max-w-3xl">
        <div class="text-center mb-12">
            <p class="text-sm font-bold uppercase tracking-[0.2em] text-accent-ink mb-3">{{ formKicker }}</p>
            <h2 class="text-3xl md:text-4xl font-bold text-ink">{{ formHeading }}</h2>
            <p class="mt-4 text-ink/70 max-w-xl mx-auto leading-relaxed">
                {{ formIntroduction }}
            </p>
        </div>

        <details class="group mb-6 rounded-2xl border border-line bg-surface-muted text-sm text-muted" data-contact-collection-notice>
            <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 rounded-2xl px-5 py-3 font-bold text-ink transition hover:bg-surface [&::-webkit-details-marker]:hidden">
                <span>Before you send <span class="ml-1 font-normal text-muted">· Privacy and form details</span></span>
                <svg class="h-5 w-5 shrink-0 text-accent-ink transition group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </summary>
            <div class="border-t border-line px-5 pb-5 pt-4 leading-relaxed">
                <p>
                    Naked Tech (Peter Reginald, ABN 57 221 340 918) collects the information you enter to assess and respond to your enquiry and, if appropriate, arrange the requested service. Fields marked with an asterisk are required to submit the form; other fields are optional. If you do not provide the required information, we cannot receive or respond to the enquiry.
                </p>
                <p class="mt-3">
                    The form is delivered through Digital Sanctum’s Sanctum Forms system. As you type, unfinished answers are saved in this browser’s local storage until you submit the form or clear that site’s stored data. The page path, relevant service category and a random session correlation code are attached to operate and trace the enquiry; referrer and campaign parameters are attached only with Analytics enabled, and advertising click identifiers only with Advertising enabled. An enquiry is not a marketing signup. See the <a href="/privacy/" class="font-bold text-accent-ink underline hover:text-ink">Privacy Policy</a> for retention, disclosures, overseas processing, access, correction and complaints.
                </p>
                <p class="mt-3">
                    To prevent automated misuse, the form uses short-lived keyed security signals and may ask Cloudflare Turnstile to verify that the submission comes from a person. Turnstile does not receive the words or contact details you enter. This necessary security check is separate from optional Analytics and Advertising choices.
                </p>
            </div>
        </details>

        <div class="w-full overflow-hidden rounded-3xl border border-line bg-surface p-2 shadow-sm sm:p-4">
            <iframe
                src="https://forms.digitalsanctum.com.au/f/{{ formSlug }}"
                width="100%"
                height="900"
                frameborder="0"
                class="block w-full"
                title="{{ iframeTitle }}"
                loading="lazy"
                data-contact-form-frame>
            </iframe>
        </div>

    </div>
</section>
<script data-contact-form-tracking>
(function() {
    var script = document.currentScript;
    var root = script && script.previousElementSibling;
    var iframe = root && root.querySelector('[data-contact-form-frame]');
    var formsOrigin = 'https://forms.digitalsanctum.com.au';
    var contextSent = false;
    var startTracked = false;
    var submissionTracked = false;

    if (!root || !iframe) return;

    function eventContext() {
        var context = { page_path: window.location.pathname };
        var painPoint = (root.dataset.painPoint || '').trim();
        if (painPoint) context.pain_point = painPoint;
        return context;
    }

    function formContext() {
        var painPoint = (root.dataset.painPoint || '').trim();
        if (window.nakedTechLeadJourney && typeof window.nakedTechLeadJourney.getContext === 'function') {
            return window.nakedTechLeadJourney.getContext(painPoint);
        }
        var consent = consentSnapshot();
        var context = {
            schema_version: 2,
            page_path: window.location.pathname,
            analytics_consent: consent.analytics,
            advertising_consent: consent.advertising,
            consent_source: consent.source || 'unavailable',
            client_storage_state: 'unavailable',
            referrer_state: document.referrer
                ? (consent.analytics === 'granted' ? 'unavailable' : 'withheld_no_consent')
                : 'missing'
        };
        if (painPoint) context.pain_point = painPoint;
        if (consent.recorded_at) context.consent_recorded_at = consent.recorded_at;
        var params = new URLSearchParams(window.location.search);
        var utmKeys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content'];
        var clickIdKeys = ['gclid', 'gbraid', 'wbraid', 'fbclid'];

        utmKeys.forEach(function(key) {
            var value = params.get(key);
            value = typeof value === 'string' ? value.trim() : '';
            if (!value) context[key + '_state'] = 'missing';
            else if (consent.analytics !== 'granted') context[key + '_state'] = 'withheld_no_consent';
            else {
                context[key + '_state'] = 'present';
                context[key] = value;
            }
        });
        clickIdKeys.forEach(function(key) {
            var value = params.get(key);
            value = typeof value === 'string' ? value.trim() : '';
            if (!value) context[key + '_state'] = 'missing';
            else if (consent.advertising !== 'granted') context[key + '_state'] = 'withheld_no_consent';
            else {
                context[key + '_state'] = 'present';
                context[key] = value;
            }
        });

        return context;
    }

    function consentSnapshot() {
        if (window.nakedTechTracking && typeof window.nakedTechTracking.getSnapshot === 'function') {
            return window.nakedTechTracking.getSnapshot();
        }
        return { analytics: 'unavailable', advertising: 'unavailable' };
    }

    function sendContext(type) {
        iframe.contentWindow.postMessage({
            type: type,
            version: 1,
            context: formContext()
        }, formsOrigin);
    }

    function validCompletion(message) {
        var uuidPattern = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;
        if (!uuidPattern.test(message.submission_id || '') || !uuidPattern.test(message.correlation_id || '')) {
            return false;
        }
        if (message.lead_event_id !== 'sf-lead-' + message.submission_id.toLowerCase()) return false;
        if (window.nakedTechLeadJourney && typeof window.nakedTechLeadJourney.getCorrelationId === 'function') {
            var expectedCorrelation = window.nakedTechLeadJourney.getCorrelationId();
            if (expectedCorrelation && expectedCorrelation.toLowerCase() !== message.correlation_id.toLowerCase()) {
                return false;
            }
        }
        return true;
    }

    window.addEventListener('message', function(e) {
        if (e.origin !== formsOrigin) return;
        if (e.source !== iframe.contentWindow) return;
        if (!e.data || Object.prototype.toString.call(e.data) !== '[object Object]') return;

        if (e.data.type === 'sanctum-forms:ready' && e.data.version === 1) {
            if (contextSent) return;
            contextSent = true;
            sendContext('sanctum-forms:context');
            return;
        }

        if (e.data.type === 'sanctum-forms:started' && e.data.version === 1) {
            if (startTracked) return;
            startTracked = true;
            if (consentSnapshot().analytics === 'granted' && typeof gtag === 'function') {
                gtag('event', 'form_start', eventContext());
            }
            return;
        }

        if (e.data.type === 'sanctum-forms:resize') {
            if (typeof e.data.height !== 'number' || !Number.isFinite(e.data.height) || e.data.height <= 0) return;
            iframe.style.height = e.data.height + 'px';
            return;
        }

        if (e.data.type !== 'sanctum-forms:submitted' || submissionTracked) return;
        if (!validCompletion(e.data)) return;
        submissionTracked = true;

        var context = eventContext();
        context.lead_event_id = e.data.lead_event_id;
        var consent = consentSnapshot();
        if (e.data.advertising_consent === 'granted' && consent.advertising === 'granted' && typeof fbq === 'function') {
            fbq('track', 'Lead', context, { eventID: e.data.lead_event_id });
        }
        if (e.data.analytics_consent === 'granted' && consent.analytics === 'granted' && typeof gtag === 'function') {
            gtag('event', 'generate_lead', context);
        }
    });

    if (window.nakedTechTracking && typeof window.nakedTechTracking.subscribe === 'function') {
        window.nakedTechTracking.subscribe(function() {
            if (contextSent) sendContext('sanctum-forms:context-update');
        });
    }
})();
</script>
{% endmacro %}
